NODE_ENV=development

POSTGRES_USER=yvi
POSTGRES_PASSWORD=yvi
POSTGRES_DB=yvi
POSTGRES_PORT=5440
DATABASE_URL=postgresql://yvi:yvi@localhost:5440/yvi

REDIS_HOST=localhost
REDIS_PORT=6390

API_PORT=3001
WORKER_HEALTH_PORT=3002
WEB_PORT=3000

LOG_LEVEL=info

# Google Cloud API key with "YouTube Data API v3" enabled, restricted to that
# API. Required for apps/worker to run real discovery/enrichment jobs.
YOUTUBE_API_KEY=

# Gemini API key (Google AI Studio). Required for apps/worker to run real
# video-classification/topic-normalization jobs (PRD §10, §19). MVP is
# Gemini-only (docs/decisions/0001-mvp-scope-decisions.md item 7).
GEMINI_API_KEY=

# Optional: overrides @yvi/ai-client's code-level default model id
# (GeminiProvider's DEFAULT_GEMINI_MODEL, packages/ai-client/src/gemini-provider.ts).
GEMINI_MODEL=

# Admin user seeded by apps/api/prisma/seed.ts (idempotent upsert on each run).
# Leave both unset to skip seeding an admin user — the seed script warns and
# continues rather than falling back to a default/blank password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server-only base URL apps/web's Route Handlers use to call apps/api
# server-to-server (never exposed to the browser, so never NEXT_PUBLIC_*).
API_INTERNAL_URL=http://localhost:3001

# Comma-separated browser origins allowed to call apps/api cross-origin
# (PRD §20.4). apps/web's own server-to-server calls are unaffected either
# way. Leave unset to disallow all cross-origin browser requests.
CORS_ALLOWED_ORIGINS=
