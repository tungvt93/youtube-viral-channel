{
  "name": "@yvi/worker",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:deps": "pnpm --filter @yvi/shared --filter @yvi/youtube-client --filter @yvi/ai-client --filter @yvi/db --filter @yvi/scoring run build",
    "prebuild": "pnpm run build:deps",
    "pretypecheck": "pnpm run build:deps",
    "pretest": "pnpm run build:deps",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@yvi/ai-client": "workspace:*",
    "@yvi/db": "workspace:*",
    "@yvi/scoring": "workspace:*",
    "@yvi/shared": "workspace:*",
    "@yvi/youtube-client": "workspace:*",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.0",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@yvi/config": "workspace:*",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.5"
  }
}
