{
  "name": "@yvi/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:deps": "pnpm --filter @yvi/shared --filter @yvi/db run build",
    "prebuild": "pnpm run build:deps",
    "pretypecheck": "pnpm run build:deps",
    "pretest": "pnpm run build:deps",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "pnpm run build:deps && node --env-file=.env -r ts-node/register prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "@yvi/db": "workspace:*",
    "argon2": "^0.45.2",
    "@yvi/shared": "workspace:*",
    "bullmq": "^5.12.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@yvi/config": "workspace:*",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.0.5"
  }
}
